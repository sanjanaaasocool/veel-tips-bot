# Rename this file to ".env" and fill in your real values below.
# NEVER share this file or commit it to GitHub.

# From Discord Developer Portal -> Your App -> Bot -> Token
DISCORD_TOKEN=your_discord_bot_token_here

# From Discord Developer Portal -> Your App -> General Information -> Application ID
CLIENT_ID=your_application_id_here

# Right-click your server icon in Discord (with Developer Mode on) -> Copy Server ID
GUILD_ID=your_server_id_here

# From Discord Developer Portal -> Your App -> Bot -> right-click the channel in
# Discord you want the Monday tip posted to (Developer Mode on) -> Copy Channel ID
TIPS_CHANNEL_ID=your_creator-tips_channel_id_here

# From Google AI Studio -> Get API key
GEMINI_API_KEY=your_gemini_api_key_here

# Channel IDs for command restrictions (right-click channel -> Copy Channel ID)
CREATOR_TIPS_CHANNEL_ID=your_creator_tips_channel_id_here
QUICK_GAMES_CHANNEL_ID=your_quick_games_channel_id_here
